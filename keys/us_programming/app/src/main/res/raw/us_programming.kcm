# US Programming physical keyboard layout.
# Both Alt keys select level 3. Undefined level 4 is explicitly none.
# Later properties take precedence: keep combined modifiers last.
# Ctrl+semicolon -> native Escape; Ctrl+period -> U+E000 via a spare key code.
# Other Ctrl/Meta combinations retain the original layout behavior.
type OVERLAY

# Report physical left Alt as right Alt / AltGr before modifier tracking.
# Standard Linux evdev KEY_LEFTALT and USB HID Keyboard Left Alt usage.
map key 56 ALT_RIGHT
map key usage 0x000700e2 ALT_RIGHT

# Keep Alt+Space usable while holding the programming layer.
# Preserve Android's default Meta/Ctrl Space fallback actions.
key SPACE {
    label: ' '
    base: ' '
    alt: ' '
    meta: fallback SEARCH
    ctrl: fallback LANGUAGE_SWITCH
}

# XKB TLDE
key GRAVE {
    label: '`'
    base: '`'
    shift: '~'
    capslock: '`'
    shift+capslock: '~'
    alt: '`'
    alt+shift: '~'
    alt+capslock: '`'
    alt+shift+capslock: '~'
}

# XKB AE01
key 1 {
    label: '1'
    base: '1'
    shift: '!'
    capslock: '1'
    shift+capslock: '!'
    alt: '1'
    alt+shift: '!'
    alt+capslock: '1'
    alt+shift+capslock: '!'
}

