# XKB BKSL
key BACKSLASH {
    label: '\\'
    base: '\\'
    shift: '|'
    capslock: '\\'
    shift+capslock: '|'
    alt: '\\'
    alt+shift: '|'
    alt+capslock: '\\'
    alt+shift+capslock: '|'
}

# Synthetic destination for Ctrl+period; no physical keys are mapped here.
# A printable private-use character bypasses terminal Ctrl-byte conversion.
key BUTTON_16 {
    label: none
    base: '\ue000'
}
